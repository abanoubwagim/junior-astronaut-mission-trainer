{
  "openapi": "3.0.3",
  "info": {
    "title": "MoonBase Mission Trainer API",
    "version": "1.0.0",
    "description": "Stateless API for MoonBase: 4 Days to Survive. Import this OpenAPI JSON file into Apidog. The backend replays the complete ordered choice history and is authoritative for resources and outcomes. No authentication or saved mission session is used. CORS allows http://localhost:5500 and http://127.0.0.1:5500 only."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Spring Boot backend"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Backend availability"
    },
    {
      "name": "Missions",
      "description": "Start and replay four-day missions"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": ["Health"],
        "operationId": "getHealth",
        "summary": "Check backend health",
        "responses": {
          "200": {
            "description": "Backend is available",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" },
                "examples": {
                  "healthy": {
                    "value": { "status": "UP" }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/missions/start": {
      "post": {
        "tags": ["Missions"],
        "operationId": "startMission",
        "summary": "Start a fresh mission",
        "description": "No request body is required. Returns Day 1 with canonical starting resources and valid choices. Creates no server-side session and saves no progress.",
        "responses": {
          "200": {
            "description": "Fresh Day 1 mission state",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MissionResponse" },
                "examples": {
                  "day1": {
                    "summary": "Initial mission state",
                    "value": {
                      "status": "ACTIVE",
                      "day": 1,
                      "totalDays": 4,
                      "resources": {
                        "power": 12,
                        "water": 12,
                        "food": 10,
                        "shelterReadiness": 8
                      },
                      "resourceDefinitions": [
                         { "key": "power", "label": "Power", "minimum": 0, "maximum": 12, "unit": "game units", "purpose": "Runs the habitat and support systems. This is a simplified game value." },
                        { "key": "water", "label": "Water", "minimum": 0, "maximum": 12, "unit": "game units", "purpose": "Keeps the crew supplied; recycling can stretch the reserve." },
                         { "key": "food", "label": "Food", "minimum": 0, "maximum": 12, "unit": "game units", "purpose": "The crew uses food each mission day; production can be delayed." },
                         { "key": "shelterReadiness", "label": "Shelter readiness", "minimum": 0, "maximum": 12, "unit": "game units", "purpose": "An abstract readiness value, not a radiation dose or shielding percentage." }
                      ],
                      "event": {
                        "day": 1,
                        "title": "Dust on the solar array",
                        "situation": "The rover spots dust on the solar array, and mission control asks the crew to prepare for a possible solar-weather alert. Use the work window to boost power later or prepare the shelter.",
                        "scienceFact": "Lunar dust can cling to exposed surfaces and make solar-array power harder to maintain. NASA has an Orion plan to use stored supplies as a shelter during a solar-particle event.",
                        "scienceSources": [
                          { "title": "Lunar Dust Considerations for Vertical Solar Arrays Volume 1: Lunar Environment and Dust Interactions", "url": "https://ntrs.nasa.gov/citations/20240003496" },
                          { "title": "Dust Mitigation for Flexible Solar Arrays (DMFlex-ACO)", "url": "https://techport.nasa.gov/projects/116295" },
                          { "title": "How NASA Will Protect Astronauts From Space Radiation at the Moon", "url": "https://science.nasa.gov/science-research/heliophysics/how-nasa-will-protect-astronauts-from-space-radiation-at-the-moon/" }
                        ],
                        "choices": [
                          { "id": "clean_solar_array", "title": "Brush the solar array", "description": "Spend 1 Power now to clear the panels.", "tradeoff": "The array adds 1 Power on each of Days 2–4." },
                          { "id": "connect_spare_battery", "title": "Connect the spare battery", "description": "Gain 1 Power now without spending rover power.", "tradeoff": "You get energy right away, but there is no later array boost." },
                          { "id": "prepare_storm_shelter", "title": "Prepare the storm shelter", "description": "Spend 1 Power and gain 2 Shelter readiness.", "tradeoff": "The prepared shelter avoids normal readiness wear on Days 2–4." }
                        ]
                      },
                      "activeEffects": [],
                      "decisionHistory": [],
                      "systems": {
                        "airLoopServiced": false,
                        "shieldingPrepared": false,
                        "shelterActivated": false,
                        "shelterMode": null,
                        "emergencyProtectionActivated": false,
                        "protectionReady": false
                      },
                      "latestDecision": null,
                      "result": null
                    }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/missions/decisions": {
      "post": {
        "tags": ["Missions"],
        "operationId": "submitDecisionHistory",
        "summary": "Replay a mission decision history",
        "description": "Send the complete ordered list from Day 1 through the newest decision. Do not send resource totals as authoritative input. The backend recalculates all values from the canonical initial state. Identical histories produce identical results.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DecisionHistoryRequest" },
              "examples": {
                "successfulFourDayMission": {
                  "summary": "A balanced path that succeeds",
                  "value": {
                    "decisions": [
                      { "day": 1, "choiceId": "clean_solar_array" },
                      { "day": 2, "choiceId": "service_water_recycler" },
                      { "day": 3, "choiceId": "start_grow_light_tray" },
                      { "day": 4, "choiceId": "full_storm_shelter" }
                    ]
                  }
                },
                "powerFailure": {
                  "summary": "A four-day path that runs out of Power",
                  "value": {
                    "decisions": [
                      { "day": 1, "choiceId": "clean_solar_array" },
                      { "day": 2, "choiceId": "use_backup_water_pack" },
                      { "day": 3, "choiceId": "start_grow_light_tray" },
                      { "day": 4, "choiceId": "full_storm_shelter" }
                    ]
                  }
                },
                "invalidChoice": {
                  "summary": "Negative test: unknown Day 1 choice (expect HTTP 400)",
                  "value": {
                    "decisions": [
                      { "day": 1, "choiceId": "not-a-choice" }
                    ]
                  }
                },
                "outOfOrder": {
                  "summary": "Negative test: history does not begin on Day 1 (expect HTTP 400)",
                  "value": {
                    "decisions": [
                      { "day": 2, "choiceId": "service_water_recycler" }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authoritative replay result, either active or terminal",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MissionResponse" },
                "examples": {
                  "success": {
                    "summary": "Successful full mission",
                    "value": {
                      "status": "SUCCEEDED",
                      "day": 4,
                      "totalDays": 4,
                      "resources": { "power": 1, "water": 6, "food": 6, "shelterReadiness": 6 },
                      "resourceDefinitions": [
                         { "key": "power", "label": "Power", "minimum": 0, "maximum": 12, "unit": "game units", "purpose": "Runs the habitat and support systems. This is a simplified game value." },
                        { "key": "water", "label": "Water", "minimum": 0, "maximum": 12, "unit": "game units", "purpose": "Keeps the crew supplied; recycling can stretch the reserve." },
                         { "key": "food", "label": "Food", "minimum": 0, "maximum": 12, "unit": "game units", "purpose": "The crew uses food each mission day; production can be delayed." },
                         { "key": "shelterReadiness", "label": "Shelter readiness", "minimum": 0, "maximum": 12, "unit": "game units", "purpose": "An abstract readiness value, not a radiation dose or shielding percentage." }
                      ],
                      "event": null,
                      "activeEffects": [],
                      "decisionHistory": [
                        { "day": 1, "choiceId": "clean_solar_array" },
                        { "day": 2, "choiceId": "service_water_recycler" },
                        { "day": 3, "choiceId": "start_grow_light_tray" },
                        { "day": 4, "choiceId": "full_storm_shelter" }
                      ],
                      "systems": {
                        "airLoopServiced": false,
                        "shieldingPrepared": false,
                        "shelterActivated": true,
                        "shelterMode": "FULL",
                        "emergencyProtectionActivated": true,
                        "protectionReady": true
                      },
                      "latestDecision": {
                        "day": 4,
                        "choiceId": "full_storm_shelter",
                         "choiceTitle": "Activate the full shelter",
                        "headline": "Day 4 decision complete",
                         "explanation": "The crew activated the full shelter. An unprepared setup costs extra Power as a simplified emergency-work rule.",
                         "whyItMatters": "Every resource is a simplified game value. Compare what helps now with what helps later.",
                        "futureEffect": "No extra effect is scheduled for a later day.",
                        "resourceBreakdown": {
                           "power": { "before": 4, "daily": -2, "delayed": 1, "event": 0, "choice": -2, "after": 1, "change": -3 },
                          "water": { "before": 7, "daily": -2, "delayed": 1, "event": 0, "choice": 0, "after": 6, "change": -1 },
                           "food": { "before": 4, "daily": -2, "delayed": 4, "event": 0, "choice": 0, "after": 6, "change": 2 },
                          "shelterReadiness": { "before": 5, "daily": -1, "delayed": 0, "event": -2, "choice": 4, "after": 6, "change": 1 }
                        }
                      },
                      "result": {
                        "status": "SUCCEEDED",
                        "title": "Four days. One brave crew. Mission complete!",
                         "summary": "The crew finished four mission days with supplies and activated protection.",
                         "limitingResource": null,
                         "primaryFailureReason": null,
                         "secondaryFailureReasons": [],
                        "takeaways": [
                          "Power, water, food, and safety planning work together.",
                          "Repairing a system can cost resources now and save them later.",
                          "NASA's Orion plan uses stored supplies to make a temporary shelter during a solar-particle event. This game's lunar shelter value is only a game measure."
                        ],
                        "decisions": [
                          { "day": 1, "title": "Brush the solar array", "lesson": "Dust can reduce solar-array performance; maintenance can repay its energy cost later." },
                          { "day": 2, "title": "Service the recycler", "lesson": "A repaired recovery system can save water on later days." },
                          { "day": 3, "title": "Start the LED grow tray", "lesson": "A powered grow tray uses water and energy before its later food benefit." },
                          { "day": 4, "title": "Power the full shelter setup", "lesson": "A stronger shelter plan uses more power and gives more readiness." }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["UP"] }
        }
      },
      "DecisionHistoryRequest": {
        "type": "object",
        "description": "The server reads only the decisions history. Unrecognized fields are ignored and never treated as authoritative mission state.",
        "required": ["decisions"],
        "properties": {
          "decisions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "description": "Complete ordered history beginning on Day 1. Each choice ID must belong to the event on the stated day.",
            "items": { "$ref": "#/components/schemas/DecisionInput" }
          }
        }
      },
      "DecisionInput": {
        "type": "object",
        "description": "Only day and choiceId are used to calculate the mission. Unrecognized fields are ignored.",
        "required": ["day", "choiceId"],
        "properties": {
          "day": { "type": "integer", "minimum": 1, "maximum": 4 },
          "choiceId": {
            "type": "string",
            "enum": [
              "clean_solar_array",
              "connect_spare_battery",
              "prepare_storm_shelter",
              "service_water_recycler",
              "use_backup_water_pack",
              "inspect_co2_removal_loop",
              "start_grow_light_tray",
              "open_meal_crate",
              "full_storm_shelter",
              "passive_storm_shelter"
            ],
            "description": "Must be a valid choice for this item's day. Day 1: clean_solar_array, connect_spare_battery, prepare_storm_shelter. Day 2: service_water_recycler, use_backup_water_pack, inspect_co2_removal_loop. Day 3: start_grow_light_tray, open_meal_crate. Day 4: full_storm_shelter, passive_storm_shelter."
          }
        }
      },
      "ResourceValues": {
        "type": "object",
        "required": ["power", "water", "food", "shelterReadiness"],
        "properties": {
          "power": { "type": "integer", "minimum": 0, "maximum": 12 },
          "water": { "type": "integer", "minimum": 0, "maximum": 12 },
          "food": { "type": "integer", "minimum": 0, "maximum": 12 },
          "shelterReadiness": { "type": "integer", "minimum": 0, "maximum": 12 }
        }
      },
      "ResourceDefinition": {
        "type": "object",
        "required": ["key", "label", "minimum", "maximum", "unit", "purpose"],
        "properties": {
          "key": { "type": "string", "enum": ["power", "water", "food", "shelterReadiness"] },
          "label": { "type": "string" },
          "minimum": { "type": "integer", "enum": [0] },
          "maximum": { "type": "integer", "enum": [12] },
          "unit": { "type": "string", "enum": ["game units"] },
          "purpose": { "type": "string" }
        }
      },
      "Choice": {
        "type": "object",
        "required": ["id", "title", "description", "tradeoff"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "tradeoff": { "type": "string" }
        }
      },
      "ScienceSource": {
        "type": "object",
        "required": ["title", "url"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" }
        }
      },
      "Event": {
        "type": "object",
        "required": ["day", "title", "situation", "scienceFact", "scienceSources", "choices"],
        "properties": {
          "day": { "type": "integer", "minimum": 1, "maximum": 4 },
          "title": { "type": "string" },
          "situation": { "type": "string" },
          "scienceFact": { "type": "string" },
          "scienceSources": { "type": "array", "items": { "$ref": "#/components/schemas/ScienceSource" } },
          "choices": { "type": "array", "minItems": 2, "items": { "$ref": "#/components/schemas/Choice" } }
        }
      },
      "ResourceBreakdown": {
        "type": "object",
        "required": ["before", "daily", "delayed", "event", "choice", "after", "change"],
        "properties": {
          "before": { "type": "integer", "minimum": 0, "maximum": 12 },
          "daily": { "type": "integer" },
          "delayed": { "type": "integer" },
          "event": { "type": "integer" },
          "choice": { "type": "integer" },
          "after": { "type": "integer", "minimum": 0, "maximum": 12 },
          "change": { "type": "integer", "minimum": -12, "maximum": 12, "description": "Actual net change after clamping; may differ from the sum of effects if a bound is reached." }
        }
      },
      "ResourceBreakdowns": {
        "type": "object",
        "required": ["power", "water", "food", "shelterReadiness"],
        "properties": {
          "power": { "$ref": "#/components/schemas/ResourceBreakdown" },
          "water": { "$ref": "#/components/schemas/ResourceBreakdown" },
          "food": { "$ref": "#/components/schemas/ResourceBreakdown" },
          "shelterReadiness": { "$ref": "#/components/schemas/ResourceBreakdown" }
        }
      },
      "DecisionFeedback": {
        "type": "object",
        "required": ["day", "choiceId", "choiceTitle", "headline", "explanation", "whyItMatters", "futureEffect", "resourceBreakdown"],
        "properties": {
          "day": { "type": "integer", "minimum": 1, "maximum": 4 },
          "choiceId": { "type": "string" },
          "choiceTitle": { "type": "string" },
          "headline": { "type": "string" },
          "explanation": { "type": "string" },
          "whyItMatters": { "type": "string" },
          "futureEffect": { "type": "string" },
          "resourceBreakdown": { "$ref": "#/components/schemas/ResourceBreakdowns" }
        }
      },
      "ResolvedChoice": {
        "type": "object",
        "required": ["day", "title", "lesson"],
        "properties": {
          "day": { "type": "integer", "minimum": 1, "maximum": 4 },
          "title": { "type": "string" },
          "lesson": { "type": "string" }
        }
      },
      "MissionResult": {
        "type": "object",
        "required": ["status", "title", "summary", "limitingResource", "primaryFailureReason", "secondaryFailureReasons", "takeaways", "decisions"],
        "properties": {
          "status": { "type": "string", "enum": ["SUCCEEDED", "FAILED"] },
          "title": { "type": "string" },
          "summary": { "type": "string" },
          "limitingResource": { "type": "string", "enum": ["Power", "Water", "Food", "Shelter readiness"], "nullable": true },
          "primaryFailureReason": { "type": "string", "nullable": true },
          "secondaryFailureReasons": { "type": "array", "items": { "type": "string" } },
          "takeaways": { "type": "array", "items": { "type": "string" } },
          "decisions": { "type": "array", "items": { "$ref": "#/components/schemas/ResolvedChoice" } }
        }
      },
      "MissionResponse": {
        "type": "object",
        "required": ["status", "day", "totalDays", "resources", "resourceDefinitions", "event", "activeEffects", "decisionHistory", "systems", "latestDecision", "result"],
        "properties": {
          "status": { "type": "string", "enum": ["ACTIVE", "SUCCEEDED", "FAILED"] },
          "day": { "type": "integer", "minimum": 1, "maximum": 4 },
          "totalDays": { "type": "integer", "enum": [4] },
          "resources": { "$ref": "#/components/schemas/ResourceValues" },
          "resourceDefinitions": { "type": "array", "items": { "$ref": "#/components/schemas/ResourceDefinition" } },
          "event": { "allOf": [{ "$ref": "#/components/schemas/Event" }], "nullable": true },
          "activeEffects": { "type": "array", "items": { "type": "string" } },
          "decisionHistory": { "type": "array", "items": { "$ref": "#/components/schemas/DecisionInput" } },
          "systems": { "$ref": "#/components/schemas/SystemState" },
          "latestDecision": { "allOf": [{ "$ref": "#/components/schemas/DecisionFeedback" }], "nullable": true },
          "result": { "allOf": [{ "$ref": "#/components/schemas/MissionResult" }], "nullable": true }
        }
      },
      "SystemState": {
        "type": "object",
        "required": ["airLoopServiced", "shieldingPrepared", "shelterActivated", "shelterMode", "emergencyProtectionActivated", "protectionReady"],
        "properties": {
          "airLoopServiced": { "type": "boolean" },
          "shieldingPrepared": { "type": "boolean" },
          "shelterActivated": { "type": "boolean" },
          "shelterMode": { "type": "string", "enum": ["FULL", "PASSIVE"], "nullable": true },
          "emergencyProtectionActivated": { "type": "boolean" },
          "protectionReady": { "type": "boolean" }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "enum": ["EMPTY_HISTORY", "INVALID_HISTORY", "INVALID_CHOICE", "POST_TERMINAL_DECISION", "MALFORMED_REQUEST", "NOT_FOUND", "INTERNAL_ERROR"] },
          "message": { "type": "string" }
        }
      },
      "ApiError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "$ref": "#/components/schemas/ErrorDetail" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Request is malformed or its decision history is invalid",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" },
            "examples": {
              "invalidChoice": {
                "value": { "error": { "code": "INVALID_CHOICE", "message": "That choice is not available for this day." } }
              },
              "invalidHistory": {
                "value": { "error": { "code": "INVALID_HISTORY", "message": "Decisions must contain one choice for each day, in order, starting at Day 1." } }
              },
              "emptyHistory": {
                "value": { "error": { "code": "EMPTY_HISTORY", "message": "Choose an option for Day 1 before sending decisions." } }
              },
              "postTerminal": {
                "value": { "error": { "code": "POST_TERMINAL_DECISION", "message": "The mission already ended. Start a new mission before sending another choice." } }
              },
              "malformedRequest": {
                "value": { "error": { "code": "MALFORMED_REQUEST", "message": "Send a valid JSON mission request." } }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "API route does not exist",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" },
            "example": { "error": { "code": "NOT_FOUND", "message": "That API route does not exist." } }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected server error; no stack trace is exposed",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ApiError" },
            "example": { "error": { "code": "INTERNAL_ERROR", "message": "The mission service could not complete that request." } }
          }
        }
      }
    }
  }
}
