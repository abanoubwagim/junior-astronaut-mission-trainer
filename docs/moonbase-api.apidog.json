{
  "openapi": "3.0.3",
  "info": {
    "title": "MoonBase Mission API",
    "version": "2026.11.14",
    "description": "Stateless qualitative API for the four-day MoonBase educational simulation. The backend replays the ordered Day 1–Day 4 decision history and does not store mission progress. Day 4 is a simulated alert, not live NASA telemetry, and has no final success/failure classification."
  },
  "servers": [{"url": "http://localhost:8080/api/v1"}],
  "paths": {
    "/health": {"get": {"responses": {"200": {"description": "Backend is available", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthResponse"}}}}}}},
    "/missions/start": {"post": {"summary": "Start Day 1 on the Moon", "responses": {"200": {"description": "Day 1 Power Drop event", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MissionResponse"}}}}}}},
    "/missions/decisions": {
      "post": {
        "summary": "Replay the ordered mission decision history",
        "description": "Send the complete ordered history. The client does not send resource values or final consequences. A three-decision history opens Day 4; a four-decision history returns the descriptive Day 4 report.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DecisionHistoryRequest"}}}},
        "responses": {
          "200": {"description": "Authoritative mission state", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MissionResponse"}}}},
          "400": {"description": "Invalid or out-of-order history", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string", "example": "UP"}}},
      "DecisionInput": {"type": "object", "required": ["day", "choiceId"], "properties": {"day": {"type": "integer", "minimum": 1, "maximum": 4}, "choiceId": {"type": "string", "enum": ["use_stored_energy", "begin_vsat_deployment", "reduce_non_essential_loads", "inspect_reprocess_water", "use_stored_potable_water", "conserve_water", "START_LIMITED_CROP_TRIAL", "PRESERVE_STORED_FOOD", "EXPAND_CROP_PRODUCTION", "REPOSITION_WATER_SUPPLIES", "REPOSITION_FOOD_SUPPLIES", "MAINTAIN_EXISTING_SHIELDING"]}}},
      "DecisionHistoryRequest": {"type": "object", "required": ["decisions"], "properties": {"decisions": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/components/schemas/DecisionInput"}}}},
      "Choice": {"type": "object", "required": ["id", "title", "description", "immediateBenefit", "tradeoff"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "description": {"type": "string"}, "immediateBenefit": {"type": "string"}, "tradeoff": {"type": "string"}}},
      "ScienceSource": {"type": "object", "required": ["title", "url"], "properties": {"title": {"type": "string"}, "url": {"type": "string", "format": "uri"}}},
      "SystemStatus": {"type": "object", "required": ["system", "status"], "properties": {"system": {"type": "string"}, "status": {"type": "string"}}},
      "InspectionReport": {"type": "object", "properties": {"arrayCondition": {"type": "string"}, "sunlightExposure": {"type": "string"}, "powerGeneration": {"type": "string"}, "eventCause": {"type": "string"}}},
      "Event": {"type": "object", "required": ["day", "title", "description", "scientificExplanation", "eventCause", "choices", "dataStatus", "valueOrigin", "systemReport", "contextNote"], "properties": {"day": {"type": "integer"}, "title": {"type": "string"}, "description": {"type": "string"}, "scientificExplanation": {"type": "string"}, "eventCause": {"type": "string"}, "inspectionReport": {"allOf": [{"$ref": "#/components/schemas/InspectionReport"}], "nullable": true}, "scienceSources": {"type": "array", "items": {"$ref": "#/components/schemas/ScienceSource"}}, "choices": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/components/schemas/Choice"}}, "dataStatus": {"type": "string"}, "valueOrigin": {"type": "string"}, "systemReport": {"type": "array", "items": {"$ref": "#/components/schemas/SystemStatus"}}, "contextNote": {"type": "string"}, "scientificEvidence": {"allOf": [{"$ref": "#/components/schemas/ScientificEvidence"}], "nullable": true}}},
      "EvidenceSource": {"type": "object", "required": ["organization", "title", "url", "dataUrl"], "properties": {"organization": {"type": "string"}, "title": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "dataUrl": {"type": "string", "format": "uri"}}},
      "ProjectedCoordinate": {"type": "object", "required": ["x", "y"], "properties": {"x": {"type": "number", "example": -11152.5}, "y": {"type": "number", "example": -12052.5}}},
      "DatasetHash": {"type": "object", "required": ["datasetId", "sha256"], "properties": {"datasetId": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}}},
      "EvidenceProvenance": {"type": "object", "required": ["methodologyId", "sourceDatasetIds", "sourceKernelIds", "originalDatasetHashes", "bundledArtifactChecksumStatus"], "properties": {"methodologyId": {"type": "string"}, "sourceDatasetIds": {"type": "array", "items": {"type": "string"}}, "sourceKernelIds": {"type": "array", "items": {"type": "string"}}, "originalDatasetHashes": {"type": "array", "items": {"$ref": "#/components/schemas/DatasetHash"}}, "bundledArtifactChecksumStatus": {"type": "string", "example": "VERIFIED_BUNDLED_ARTIFACTS_ONLY"}}},
      "ScientificEvidence": {"type": "object", "required": ["evidenceId", "manifestVersion", "classification", "nasaSource", "datasetIdentifier", "datasetSourcePath", "researchSite", "candidateId", "projectedCoordinate", "projectionDescription", "referenceFrame", "epochUtc", "testedHeightsM", "idealizedHorizonResult", "localTerrainObstructionResult", "testedDemModelIds", "independentVerificationClassification", "frameReviewStatus", "day1ScientificDecision", "educationalExplanation", "childFriendlyExplanation", "teamAnalysisSummary", "minimumReportedObstructionMarginDeg", "limitationNotes", "provenance", "electricalPowerMeasurementStatus"], "properties": {"evidenceId": {"type": "string"}, "manifestVersion": {"type": "string", "example": "1.0.1"}, "classification": {"type": "string", "enum": ["TEAM_DERIVED"]}, "nasaSource": {"$ref": "#/components/schemas/EvidenceSource"}, "datasetIdentifier": {"type": "string"}, "datasetSourcePath": {"type": "string"}, "researchSite": {"type": "string"}, "candidateId": {"type": "string", "example": "ROI5_C1"}, "projectedCoordinate": {"$ref": "#/components/schemas/ProjectedCoordinate"}, "projectionDescription": {"type": "string"}, "referenceFrame": {"type": "string", "example": "MOON_ME_DE421"}, "epochUtc": {"type": "string", "format": "date-time"}, "testedHeightsM": {"type": "array", "items": {"type": "integer"}}, "idealizedHorizonResult": {"type": "string", "example": "ILLUMINATED"}, "localTerrainObstructionResult": {"type": "string", "example": "OBSTRUCTED"}, "testedDemModelIds": {"type": "array", "items": {"type": "string"}}, "independentVerificationClassification": {"type": "string", "example": "CONFIRMED_WITH_LIMITATIONS"}, "frameReviewStatus": {"type": "string", "example": "CLOSED_WITH_LIMITATIONS"}, "day1ScientificDecision": {"type": "string", "example": "READY_WITH_LIMITATIONS"}, "educationalExplanation": {"type": "string"}, "childFriendlyExplanation": {"type": "string"}, "teamAnalysisSummary": {"type": "string"}, "minimumReportedObstructionMarginDeg": {"type": "number"}, "limitationNotes": {"type": "array", "items": {"type": "string"}}, "provenance": {"$ref": "#/components/schemas/EvidenceProvenance"}, "electricalPowerMeasurementStatus": {"type": "string", "example": "UNAVAILABLE"}}},
      "QualitativeState": {"type": "object", "description": "Qualitative game labels only; no physical units or invented measurements.", "properties": {"solarInput": {"type": "string"}, "arrayCondition": {"type": "string"}, "sunlightExposure": {"type": "string"}, "eventCause": {"type": "string"}, "backupReserve": {"type": "string"}, "powerDemand": {"type": "string"}, "powerAllocation": {"type": "string"}, "verticalArrayStatus": {"type": "string"}, "dataStatus": {"type": "string"}, "valueOrigin": {"type": "string"}, "waterRecoveryStatus": {"type": "string"}, "potableWaterSupply": {"type": "string"}, "waterQualityVerification": {"type": "string"}, "crewLifeSupport": {"type": "string"}, "recoveredWaterDisposition": {"type": "string"}, "dayTwoPersistentState": {"type": "string"}, "storedFoodSupply": {"type": "string"}, "cropProductionUnit": {"type": "string"}, "cropGrowth": {"type": "string"}, "approvedWaterForCrops": {"type": "string"}, "powerAvailability": {"type": "string"}, "dayThreePersistentState": {"type": "string"}, "cropOperationStatus": {"type": "string"}, "cropOperationalConstraint": {"type": "string"}, "approvedWaterForShielding": {"type": "string"}, "packagedFoodForShielding": {"type": "string"}, "evaStatus": {"type": "string"}, "crewLocation": {"type": "string"}, "primaryShielding": {"type": "string"}, "supplementaryShielding": {"type": "string"}, "dayFourPersistentState": {"type": "string"}, "dayFourOperationalConstraint": {"type": "string"}}},
      "ActiveEffect": {"type": "object", "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "state": {"type": "string"}, "description": {"type": "string"}}},
      "DecisionFeedback": {"type": "object", "properties": {"day": {"type": "integer"}, "choiceId": {"type": "string"}, "choiceTitle": {"type": "string"}, "resultMessage": {"type": "string"}, "explanation": {"type": "string"}, "preserved": {"type": "string"}, "reducedOrDelayed": {"type": "string"}, "backupReserve": {"type": "string"}, "persistentEffect": {"type": "string"}, "scientificTakeaway": {"type": "string"}}},
      "ResolvedChoice": {"type": "object", "properties": {"day": {"type": "integer"}, "choiceId": {"type": "string"}, "title": {"type": "string"}}},
      "MissionResult": {"type": "object", "properties": {"status": {"type": "string"}, "title": {"type": "string"}, "summary": {"type": "string"}, "selectedDecision": {"$ref": "#/components/schemas/ResolvedChoice"}, "preserved": {"type": "string"}, "reducedOrDelayed": {"type": "string"}, "powerStatus": {"type": "string"}, "backupReserve": {"type": "string"}, "persistentEffects": {"type": "array", "items": {"$ref": "#/components/schemas/ActiveEffect"}}, "scientificTakeaway": {"type": "string"}, "nextChapterAvailable": {"type": "boolean"}, "nextChapterMessage": {"type": "string"}}},
      "MissionResponse": {"type": "object", "required": ["status", "day", "totalDays", "qualitativeState", "activeEffects", "decisionHistory"], "properties": {"status": {"type": "string", "enum": ["ACTIVE", "DAY_1_COMPLETE", "DAY_2_COMPLETE", "DAY_3_COMPLETE", "DAY_4_COMPLETE"]}, "day": {"type": "integer", "minimum": 1, "maximum": 4}, "totalDays": {"type": "integer", "example": 4}, "event": {"allOf": [{"$ref": "#/components/schemas/Event"}], "nullable": true}, "qualitativeState": {"$ref": "#/components/schemas/QualitativeState"}, "activeEffects": {"type": "array", "items": {"$ref": "#/components/schemas/ActiveEffect"}}, "decisionHistory": {"type": "array", "items": {"$ref": "#/components/schemas/DecisionInput"}}, "latestDecision": {"allOf": [{"$ref": "#/components/schemas/DecisionFeedback"}], "nullable": true}, "result": {"allOf": [{"$ref": "#/components/schemas/MissionResult"}], "nullable": true}}},
      "ApiError": {"type": "object", "properties": {"error": {"type": "object", "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}}}
    }
  }
}
