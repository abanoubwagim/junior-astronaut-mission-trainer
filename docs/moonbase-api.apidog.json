{
  "openapi": "3.0.3",
  "info": {
    "title": "MoonBase Day 1 Mission API",
    "version": "2026.11.10",
    "description": "Stateless qualitative API for MoonBase Day 1: Establish the Base. NASA-backed readings are DATA_UNAVAILABLE until the verified package is integrated."
  },
  "servers": [{"url": "http://localhost:8080/api/v1"}],
  "paths": {
    "/health": {
      "get": {
        "responses": {"200": {"description": "Backend is available", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthResponse"}}}}}
      }
    },
    "/missions/start": {
      "post": {
        "summary": "Start Day 1 on the Moon",
        "responses": {"200": {"description": "Day 1 Power Drop event", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MissionResponse"}}}}}
      }
    },
    "/missions/decisions": {
      "post": {
        "summary": "Confirm the single Day 1 choice",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DecisionHistoryRequest"}}}},
        "responses": {
          "200": {"description": "Day 1 complete", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MissionResponse"}}}},
          "400": {"description": "Invalid or later-day history", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ApiError"}}}}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string", "example": "UP"}}},
      "DecisionInput": {"type": "object", "required": ["day", "choiceId"], "properties": {"day": {"type": "integer", "example": 1}, "choiceId": {"type": "string", "enum": ["reduce_non_essential_loads", "switch_to_backup_batteries", "prioritize_life_support"]}}},
      "DecisionHistoryRequest": {"type": "object", "required": ["decisions"], "properties": {"decisions": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/components/schemas/DecisionInput"}}}},
      "Choice": {"type": "object", "required": ["id", "title", "description", "tradeoff"], "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "description": {"type": "string"}, "tradeoff": {"type": "string"}}},
      "Event": {"type": "object", "required": ["day", "title", "situation", "scienceFact", "scienceSources", "choices", "dataStatus"], "properties": {"day": {"type": "integer", "example": 1}, "title": {"type": "string", "example": "POWER DROP"}, "situation": {"type": "string"}, "scienceFact": {"type": "string"}, "scienceSources": {"type": "array", "items": {"type": "object", "properties": {"title": {"type": "string"}, "url": {"type": "string", "format": "uri"}}}}, "choices": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/components/schemas/Choice"}}, "dataStatus": {"type": "string", "example": "DATA_UNAVAILABLE"}}},
      "QualitativeState": {"type": "object", "required": ["solarInput", "powerAllocation", "backupReserve", "crewSupport", "dataStatus", "valueOrigin"], "properties": {"solarInput": {"type": "string"}, "powerAllocation": {"type": "string"}, "backupReserve": {"type": "string"}, "crewSupport": {"type": "string"}, "dataStatus": {"type": "string", "example": "DATA_UNAVAILABLE"}, "valueOrigin": {"type": "string", "example": "GAME_SIMULATION"}}},
      "DecisionFeedback": {"type": "object", "required": ["day", "choiceId", "choiceTitle", "headline", "explanation", "whyItMatters", "futureEffect", "preserved", "reducedOrDelayed", "reserveState"], "properties": {"day": {"type": "integer"}, "choiceId": {"type": "string"}, "choiceTitle": {"type": "string"}, "headline": {"type": "string"}, "explanation": {"type": "string"}, "whyItMatters": {"type": "string"}, "futureEffect": {"type": "string"}, "preserved": {"type": "string"}, "reducedOrDelayed": {"type": "string"}, "reserveState": {"type": "string"}}},
      "ResolvedChoice": {"type": "object", "properties": {"day": {"type": "integer"}, "title": {"type": "string"}, "lesson": {"type": "string"}}},
      "MissionResult": {"type": "object", "properties": {"status": {"type": "string", "example": "DAY_1_COMPLETE"}, "title": {"type": "string"}, "summary": {"type": "string"}, "limitingResource": {"type": "string", "nullable": true}, "primaryFailureReason": {"type": "string", "nullable": true}, "secondaryFailureReasons": {"type": "array", "items": {"type": "string"}}, "takeaways": {"type": "array", "items": {"type": "string"}}, "decisions": {"type": "array", "items": {"$ref": "#/components/schemas/ResolvedChoice"}}}},
      "MissionResponse": {"type": "object", "required": ["status", "day", "totalDays", "event", "qualitativeState", "activeEffects", "decisionHistory", "latestDecision", "result"], "properties": {"status": {"type": "string", "enum": ["ACTIVE", "DAY_1_COMPLETE"]}, "day": {"type": "integer", "example": 1}, "totalDays": {"type": "integer", "example": 4}, "event": {"allOf": [{"$ref": "#/components/schemas/Event"}], "nullable": true}, "qualitativeState": {"$ref": "#/components/schemas/QualitativeState"}, "activeEffects": {"type": "array", "items": {"type": "string"}}, "decisionHistory": {"type": "array", "items": {"$ref": "#/components/schemas/DecisionInput"}}, "latestDecision": {"allOf": [{"$ref": "#/components/schemas/DecisionFeedback"}], "nullable": true}, "result": {"allOf": [{"$ref": "#/components/schemas/MissionResult"}], "nullable": true}}},
      "ApiError": {"type": "object", "properties": {"error": {"type": "object", "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}}}
    }
  }
}
