# NASA_API_KEY/API_KEY is intentionally optional for the current CCMC DONKI
# integration. DONKI's public OpenAPI does not declare an API-key parameter.
API_KEY=replace-with-a-local-value-if-another-NASA-service-requires-one
NASA_API_KEY=

# Comma-separated browser origins allowed to call the backend.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Optional operational overrides.
NASA_DONKI_BASE_URL=https://ccmc.gsfc.nasa.gov/DONKI-API
NASA_CONNECT_TIMEOUT=2s
NASA_READ_TIMEOUT=4s
NASA_CACHE_TTL=15m
NASA_LOOKBACK_DAYS=30
